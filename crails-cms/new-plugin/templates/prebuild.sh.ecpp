std::string @project_name;
std::string @html_renderer_classname;
std::string @json_renderer_classname;
std::string @rss_renderer_classname;
bool @with_javascript = true;
bool @with_json = true;
bool @with_rss = true;
// END LINKING

#!/bin/sh

##
## Renderers
##
crails templates build \
  -r html \
  -i app/views \
  -t Crails::HtmlTemplate \
  -z crails/html_template.hpp \
  -n <%= html_renderer_classname %> \
  -p \.html$ \
  -v

<% if (with_json) do -%>
crails templates build \
  -r json \
  -m raw \
  -i app/views \
  -t Crails::JsonTemplate \
  --stream-property stream \
  -z crails/json_template.hpp \
  -n <%= json_renderer_classname %> \
  -p \.json$ \
  -v
<% end -%>

<% if (with_rss) do -%>
crails templates build \
  -r rss \
  -i app/views \
  -t Crails::RssTemplate \
  -z crails/rss_template.hpp \
  -n <%= rss_renderer_classname %> \
  -p \.rss$ \
  -v
<% end -%>

<% if (with_javascript) do -%>
##
## JavaScript
##
npm install
node_modules/.bin/webpack
xxd -i -n <%= project_name %>_plugin_application_js lib/application.js lib/application.js.cpp
xxd -i -n <%= project_name %>_plugin_admin_js lib/admin.js lib/admin.js.cpp
<% end -%>

##
## Database
##
ODB_AUTOGEN_PATH="app/autogen/odb"
ODB_CXX_INCLUDES="-I. -I../.."
if [ ! -z "$CRAILS_CMS_INCLUDE_DIRS" ] ; then
  ODB_CXX_INCLUDES="$odb_includes -I$CRAILS_CMS_INCLUDE_DIRS"
fi

odb \
  $ODB_CXX_INCLUDES \
  --std c++20 \
  --default-pointer std::shared_ptr \
  -d pgsql \
  --table-prefix "<%= project_name %>_" \
  --generate-schema --schema-format sql \
  --generate-query \
  --output-dir "$ODB_AUTOGEN_PATH" \
  app/models/*.hpp

##
## Fix ODB include paths
##
plugin_odb_hxx="`pwd`/lib/plugin-odb.hxx"
search_dirs=". .. /usr/local/include $CRAILS_CMS_INCLUDE_DIRS"

# Step 1, create headers to redirect towards the real model headers
cd app/models
model_filenames=`find . -name "*.hpp"`
cd -
cd $ODB_AUTOGEN_DIR
for filename in $model_filenames ; do
  touch "$filename" && echo "#include \"../../models/$filename\"" > "$filename"
done
cd -

# Step 2, remove broken include paths, add include to the global odb header
for target in "$ODB_AUTOGEN_DIR"/*-odb.hxx ; do
  [ -e "$target" ] || continue

  awk -v owndir="$ODB_AUTOGEN_DIR" \
      -v searchdirs="$search_dirs" \
      -v bridge='#include "app/autogen/odb/application-odb.hpp"' \
      -f prebuild-fix-odb.awk \
      "$target" > "$target.tmp"
  mv "$target.tmp" "$target"
done

##
## Generate plugin-odb.hxx                                                                                                          
##
plugin_odb_path="`pwd`/$ODB_AUTOGEN_DIR"
plugin_odb_hpp="$plugin_odb_path/plugin-odb.hxx"                                                                                    
cd app/models
if [ -f "$plugin_odb_hpp" ] ; then                                                                                                  
  rm "$plugin_odb_hpp"                                                                                                              
fi
echo "#pragma once" >> "$plugin_odb_hpp"
echo "#include \"app/autogen/odb/application-odb.hpp\"" >> "$plugin_odb_hpp"                                                        
for filepath in `find . -name "*.h*"` ; do                                                                                          
  filename=$(basename -- "$filepath")                                                                                               
  extension="${filename##*.}"                                                                                                       
  filename="${filename%.*}"                                                                                                         
  if [ -f "$plugin_odb_path/$filename-odb.hxx" ] ; then                                                                             
    echo "#include \"$filename-odb.hxx\"" >> "$plugin_odb_hpp"                                                                      
  fi                                                                                                                                
done                                                                                                                                
cd -

##
## Generate database migration
##
set -e
output="app/database.cpp"

strip_comments() { sed '/\/\*/,/\*\//d' "$1"; }

emit() {
  for file in lib/*.sql; do
    strip_comments "$file" | awk -v mode="$1" -f "prebuild-schema.awk"
  done
}

{
  echo "// This file was generated automatically by prebuild.sh"
  echo '#include <crails/odb/connection.hpp>'
  echo
  echo 'void install_plugin_database()'
  echo '{'
  echo '  Crails::Odb::Connection database;'
  echo
  echo '  database.transaction.require("odb");'
  emit install
  echo '  database.commit();'
  echo '}'
  echo
  echo 'void uninstall_plugin_database()'
  echo '{'
  echo '  Crails::Odb::Connection database;'
  echo
  echo '  database.transaction.require("odb");'
  emit uninstall
  echo '  database.commit();'
  echo '}'
} > "$output"

echo "Generated $output"
