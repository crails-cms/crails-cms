function resolves(inc,    n, dirs, i) {
  if (system("test -f \"" owndir "/" inc "\"") == 0) return 1
  n = split(searchdirs, dirs, " ")
  for (i = 1; i <= n; i++)
    if (system("test -f \"" dirs[i] "/" inc "\"") == 0) return 1
  return 0
}
